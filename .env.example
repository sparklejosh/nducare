# ---- Required in production ----
NODE_ENV=production
PORT=3000
# Long random string. Generate: openssl rand -hex 32
JWT_SECRET=
# SQLite path on a PERSISTENT disk (Render: /var/data/nducare.db, Fly: /data/nducare.db)
DB_PATH=./data/nducare.db

# ---- Web Push (optional; auto-generated & saved next to the DB if blank) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# ---- Paystack (optional; leave blank = demo mode, payments auto-succeed) ----
# Get keys at dashboard.paystack.com → Settings → API Keys & Webhooks
# Webhook URL to set there: https://yourdomain.com/api/payments/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- Split hosting (frontend on Netlify etc.) ----
# Allowed frontend origins, comma-separated. Leave blank if this server serves the frontend itself.
CORS_ORIGIN=
# Public URL of the frontend (used for Paystack return URL & push notification links)
FRONTEND_URL=

# ---- Free-tier persistence (Render Free / Koyeb Free have no disk) ----
# Snapshot the SQLite DB to Turso (free 5 GB) after every write and restore on boot. See FREE.md
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Self-ping to stay awake on sleeping free tiers (also add a cron-job.org ping)
KEEPALIVE_URL=

# Video relay (TURN) for mobile networks. Free: metered.ca -> create app -> copy domain + API key.
# Without these the app falls back to the public Open Relay TURN (best effort).
METERED_DOMAIN=
METERED_API_KEY=
# or any TURN server:
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
